{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/dialer/parallel-maintenance",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/dialer/maintenance",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/docusign/reconcile",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/signwell/reconcile",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/dialer/callback-maintenance",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/dialer/conversation-maintenance",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/dialer/health-maintenance",
      "schedule": "*/5 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/dialer.html",
      "destination": "/#power-dialer",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/dialer-inbound.xml",
      "destination": "/api/dialer/incoming"
    }
  ]
}
